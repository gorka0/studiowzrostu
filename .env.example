# Flaga indeksowania: "true" zezwala na indeksowanie (robots/sitemap), inne wartości wymuszają noindex
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Resend API Key (opcjonalny w dev – brak klucza powoduje zalogowanie wiadomości w konsoli)
RESEND_API_KEY=""

# Adresy dla formularza kontaktowego
CONTACT_TO_EMAIL="kontakt@studiowzrostu.pl"
CONTACT_FROM_EMAIL="formularz@studiowzrostu.pl"

# Opcjonalnie: Upstash Redis do rate-limitera (gdy brak, działa in-memory fallback)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Opcjonalnie: Tajny klucz do podpisywania tokenów antyspamowych formularza
CONTACT_SECRET="zmien-ten-klucz-na-produkcji"
